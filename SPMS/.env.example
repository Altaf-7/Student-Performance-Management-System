SECRET_KEY=change-this-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=*

# Leave DB_ENGINE unset (or anything other than "mysql") to use SQLite automatically.
# Set DB_ENGINE=mysql to use MySQL as described in the project README.
DB_ENGINE=mysql
DB_NAME=student_performance
DB_USER=root
DB_PASSWORD=your-password
DB_HOST=localhost
DB_PORT=3306
