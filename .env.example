# Copy this file to .env and fill in real values for your machine.
# Never commit the real .env file.

# Django
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL
DB_NAME=spms
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# Attendance thresholds (percent)
ATTENDANCE_GOOD_THRESHOLD=85
ATTENDANCE_WARNING_THRESHOLD=75

# Risk detection thresholds
RISK_MIN_GPA=6.0
RISK_MIN_ATTENDANCE=75.0

# Email (console backend is used automatically when DEBUG=True)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
